# ======================
# ONLY THESE 3 ARE REQUIRED IN ENV
# Everything else is controlled from Admin Panel
# ======================

# Admin panel login password
ADMIN_PASSWORD=change_this_strong_password

# MongoDB connection string (Atlas free tier recommended)
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/ai-sales-agent?retryWrites=true&w=majority

# Secret key for JWT & encryption (generate a long random string)
SECRET_KEY=your_super_secret_key_min_32_chars_long_here

# Optional: Port (default 3000)
PORT=3000

# Optional: Node environment
NODE_ENV=production
